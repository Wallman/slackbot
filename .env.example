# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Postgres (thread conversation history). The default below matches
# docker-compose.yml - run `docker compose up -d` to start it locally.
DATABASE_URL=postgres://slackbot:slackbot@localhost:5432/slackbot?sslmode=disable

# App Store Connect API (JWT auth)
ASC_ISSUER_ID=your-issuer-id
ASC_KEY_ID=your-key-id
ASC_PRIVATE_KEY_PATH=./keys/AuthKey_XXXXXXXXXX.p8
ASC_APP_ID=your-app-id

# Cloudflare
CF_API_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-zone-id
CF_ACCOUNT_ID=your-account-id
